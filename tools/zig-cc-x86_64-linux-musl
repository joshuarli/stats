#!/usr/bin/env python3
import os
import sys

args = []
for arg in sys.argv[1:]:
    if arg in ("--target=x86_64-unknown-linux-musl", "--target=x86_64-linux-musl", "-target=x86_64-unknown-linux-musl"):
        continue
    if arg.startswith("--target=") and "x86_64" in arg:
        continue
    args.append(arg)
os.execvp("zig", ["zig", "cc", "-target", "x86_64-linux-musl", *args])
