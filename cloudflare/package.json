{
  "name": "@stats/telemetry",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "26.12.1"
  },
  "scripts": {
    "test": "node scripts/test-runner.mjs",
    "test:unit": "node --experimental-strip-types --test test/binary/*.test.ts test/ingest/*.test.ts test/deployments/*.test.ts test/cost/*.test.ts test/scripts/*.test.ts test/observe/*.test.ts test/node/*.test.ts",
    "test:ui": "playwright test",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "typecheck": "node scripts/typecheck.mjs",
    "lint": "oxlint --type-aware src test bench observe-worker vite.config.ts playwright.config.ts",
    "prebuild": "pnpm --filter @joshuarli/ui build",
    "build": "vite build",
    "build:observe": "vite build --config observe-worker/vite.config.ts",
    "build:all": "node scripts/build-all.mjs",
    "statsctl": "node --experimental-strip-types src/cli/statsctl.ts",
    "observe": "node --experimental-strip-types src/observe/client/cli.ts",
    "test:binary": "node --experimental-strip-types --test test/binary/*.test.ts",
    "test:ingest": "node --experimental-strip-types --test test/ingest/*.test.ts",
    "test:agent-e2e": "node --experimental-strip-types --test test/agent-e2e/*.test.ts",
    "test:node-e2e": "node --experimental-strip-types --test test/node-e2e/*.test.ts",
    "typecheck:binary": "tsrs -p binary.tsconfig.json --noEmit --fast",
    "test:deployments": "node --experimental-strip-types --test test/deployments/*.test.ts",
    "test:cost": "node --experimental-strip-types --test test/cost/*.test.ts",
    "test:cli": "node --experimental-strip-types --test test/cli/*.test.ts",
    "test:scripts": "node --experimental-strip-types --test test/scripts/*.test.ts",
    "typecheck:deployments": "tsrs -p deployments.tsconfig.json --noEmit --fast",
    "test:observe": "node --experimental-strip-types --test test/observe/*.test.ts",
    "test:observe-e2e": "node --experimental-strip-types --test test/observe-e2e/*.test.ts",
    "test:node": "node --experimental-strip-types --test test/node/*.test.ts",
    "test:local": "node --experimental-strip-types --test test/local/*.test.ts",
    "bench:workerd": "vitest run --config vitest.bench.config.mjs --disableConsoleIntercept",
    "typecheck:observe": "tsrs -p observe.tsconfig.json --noEmit --fast"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.8",
    "@cloudflare/vitest-plugin": "1.4.11",
    "@cloudflare/workers-types": "5.20261031.1",
    "@jridgewell/sourcemap-codec": "1.6.0",
    "@playwright/test": "1.64.1",
    "@solidjs/vite-plugin": "3.0.0-next.54",
    "@types/node": "26.6.6",
    "cf": "1.0.0-beta.26",
    "esbuild": "0.28.2",
    "miniflare": "5.20261023.3-beta",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@joshuarli/ui": "workspace:*",
    "@jridgewell/trace-mapping": "0.3.31",
    "@solidjs/router": "2.0.0-next.43",
    "@solidjs/web": "2.0.0-rc.20",
    "solid-js": "2.0.0-rc.20",
    "uplot": "1.6.32"
  }
}
