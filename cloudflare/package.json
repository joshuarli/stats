{
  "name": "@stats/telemetry",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "test": "node scripts/test-runner.mjs",
    "test:unit": "node scripts/run-tests.mjs --file test/binary --file test/ingest --file test/deployments --file test/cost --file test/scripts --file test/observe --file test/node",
    "test:ui": "playwright test",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "typecheck": "tsrs -p tsconfig.json --noEmit --fast && tsrs -p binary.tsconfig.json --noEmit --fast && tsrs -p deployments.tsconfig.json --noEmit --fast && tsrs -p observe.tsconfig.json --noEmit --fast",
    "lint": "oxlint --type-aware src test bench observe-worker vite.config.ts playwright.config.ts",
    "build": "vite build",
    "build:observe": "vite build --config observe-worker/vite.config.ts",
    "build:all": "node scripts/build-all.mjs",
    "test:all": "node scripts/worker-test.mjs",
    "statsctl": "node --experimental-strip-types src/cli/statsctl.ts",
    "observe": "node --experimental-strip-types src/observe/client/cli.ts",
    "test:binary": "node scripts/run-tests.mjs --file test/binary",
    "test:ingest": "node scripts/run-tests.mjs --file test/ingest",
    "test:agent-e2e": "node scripts/run-tests.mjs --suite agent-e2e",
    "test:node-e2e": "node scripts/run-tests.mjs --suite node-e2e",
    "typecheck:binary": "tsrs -p binary.tsconfig.json --noEmit --fast",
    "test:deployments": "node scripts/run-tests.mjs --file test/deployments",
    "test:cost": "node scripts/run-tests.mjs --file test/cost",
    "test:cli": "node scripts/run-tests.mjs --file test/cli",
    "test:scripts": "node scripts/run-tests.mjs --file test/scripts",
    "typecheck:deployments": "tsrs -p deployments.tsconfig.json --noEmit --fast",
    "test:observe": "node scripts/run-tests.mjs --file test/observe",
    "test:observe-e2e": "node scripts/run-tests.mjs --suite observe-e2e",
    "test:node": "node scripts/run-tests.mjs --file test/node",
    "test:local": "node scripts/run-tests.mjs --suite local",
    "bench:workerd": "vitest run --config vitest.bench.config.mjs --disableConsoleIntercept",
    "typecheck:observe": "tsrs -p observe.tsconfig.json --noEmit --fast"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.8",
    "@cloudflare/vitest-plugin": "1.8.0",
    "@cloudflare/workers-types": "5.20261110.1",
    "@jridgewell/sourcemap-codec": "1.6.0",
    "@playwright/test": "1.65.0",
    "@solidjs/vite-plugin": "3.0.0-next.57",
    "@types/node": "26.6.6",
    "cf": "1.0.0-beta.29",
    "miniflare": "5.20261023.3-beta",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "tsrs": "0.24.0-ts7.1.0-beta",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "0.3.31",
    "@laputa-systems/ui-dashboard": "0.9.1",
    "@solidjs/router": "2.0.0-next.43",
    "@solidjs/web": "2.0.0-rc.20",
    "solid-js": "2.0.0-rc.20",
    "uplot": "1.6.32"
  }
}
