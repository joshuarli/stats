{
  "name": "stats-worker-test",
  "main": "src/cloudflare/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "INSTALLATION",
        "class_name": "Installation"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Installation"
      ]
    }
  ],
  "assets": {
    "directory": "./.cloudflare/output/v0/workers/default/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ENVIRONMENT": "test",
    "PROJECTS": "[{\"id\":\"stuff\",\"name\":\"stuff\",\"worker\":\"stuff\",\"workerBilling\":\"requests-and-cpu\",\"buckets\":[\"stuff-mycrates\",\"stuff-mynpm\"],\"durableObjectNamespaces\":[],\"d1Databases\":[],\"probes\":[{\"name\":\"npm\",\"url\":\"https://npm.example.com/\"}]}]",
    "WORKER_NAME": "stats-worker-test",
    "TEST_NOW_MS": "1793510415000",
    "GATEWAY_SECRET": "test-gateway-secret"
  }
}
