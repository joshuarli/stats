[Unit]
Description=Niceforge block latency collector
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/lib/niceforge-telemetry/collector.sh /run/niceforge-telemetry/block-latency.json /usr/local/lib/niceforge-telemetry/biolatency-collector.bt
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
