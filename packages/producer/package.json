{
  "name": "@stats/producer",
  "version": "0.2.0",
  "description": "Bounded, non-blocking application telemetry producer for Stats",
  "type": "module",
  "license": "UNLICENSED",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsrs -p tsconfig.json",
    "typecheck": "tsrs -p tsconfig.json --noEmit",
    "lint": "oxlint --type-aware src",
    "check": "pnpm run lint && pnpm run typecheck",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "oxlint": "1.93.0",
    "tsrs": "0.25.0-ts7.1.0-beta"
  },
  "engines": {
    "node": ">=20"
  }
}
