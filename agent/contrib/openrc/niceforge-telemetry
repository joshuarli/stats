#!/sbin/openrc-run

name="niceforge telemetry"
description="Static-musl host telemetry agent"
command="/usr/local/bin/niceforge-telemetry"
command_args="--config /etc/niceforge-telemetry/agent.json"
command_user="niceforge-telemetry:niceforge-telemetry"
command_background="yes"
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/niceforge-telemetry.log"
error_log="/var/log/niceforge-telemetry.log"

depend() {
  need net
  after firewall
}
